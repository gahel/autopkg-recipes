<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest Keeper Password Manager and uploads it to Intune.</string>
	<key>Identifier</key>
	<string>com.github.gahel.intune.KeeperPasswordManager</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>KeeperPasswordManager</string>
		<key>categories</key>
		<array>
			<string>Security</string>
		</array>
		<key>description</key>
		<string>Keeper Password Manager desktop client. Secure password manager and digital vault.</string>
		<key>developer</key>
		<string>Keeper Security</string>
		<key>display_name</key>
		<string>Keeper Password Manager</string>
		<key>information_url</key>
		<string>https://www.keepersecurity.com</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.dataJAR-recipes.download.KeeperPasswordManager</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>Copier</string>
			<key>Arguments</key>
			<dict>
				<key>source_path</key>
				<string>%pathname%/Keeper Password Manager.app</string>
				<key>destination_path</key>
				<string>%RECIPE_CACHE_DIR%/Keeper Password Manager.app</string>
				<key>overwrite</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>PlistReader</string>
			<key>Arguments</key>
			<dict>
				<key>info_path</key>
				<string>%RECIPE_CACHE_DIR%/Keeper Password Manager.app/Contents/Info.plist</string>
				<key>plist_keys</key>
				<dict>
					<key>CFBundleShortVersionString</key>
					<string>version</string>
					<key>CFBundleIdentifier</key>
					<string>BUNDLE_ID</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>com.github.almenscorner.intune-upload.processors/IntuneAppIconGetter</string>
			<key>Arguments</key>
			<dict>
				<key>app_file</key>
				<string>%RECIPE_CACHE_DIR%/Keeper Password Manager.app</string>
				<key>name</key>
				<string>%NAME%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>com.github.almenscorner.intune-upload.processors/IntuneAppUploader</string>
			<key>Arguments</key>
			<dict>
				<key>app_file</key>
				<string>%pathname%</string>
				<key>bundleId</key>
				<string>%BUNDLE_ID%</string>
				<key>bundleVersion</key>
				<string>%version%</string>
				<key>description</key>
				<string>%description%</string>
				<key>displayname</key>
				<string>%display_name%</string>
				<key>icon</key>
				<string>%icon_file_path%</string>
				<key>information_url</key>
				<string>%information_url%</string>
				<key>publisher</key>
				<string>%developer%</string>
				<key>version</key>
				<string>%version%</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
